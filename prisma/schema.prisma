generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================
// ENUMS
// ==========================

enum Role {
  SALE
  PRICING
  ADMIN
}

enum QuoteStatus {
  YC_MOI
  DANG_XLY
  XONG
  TU_CHOI
  NEED_MORE_INFO
  DA_CHOT
}

// ==========================
// 1. USERS
// ==========================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  refreshTokenHash String? @map("refresh_token_hash")
  resetTokenHash   String? @map("reset_token_hash")
  resetTokenExpires DateTime? @map("reset_token_expires")
  isApproved       Boolean   @default(false) @map("is_approved")
  role         Role
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  // Quan hệ ngược - 1 user có thể đóng nhiều vai trong quote_requests
  requestedQuotes QuoteRequest[] @relation("Requester")
  pricedQuotes    QuoteRequest[] @relation("Pricer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@map("users")
}

// ==========================
// 2. DEPARTMENTS (lookup)
// ==========================

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

// ==========================
// 3. MATERIALS (lookup)
// ==========================

model Material {
  id                   String                @id @default(cuid())
  name                 String                @unique
  primaryQuoteRequests QuoteRequest[]        @relation("PrimaryMaterial")
  quoteRequests        QuoteRequestMaterial[]

  @@map("materials")
}

// ==========================
// 4. PRODUCT CATEGORIES (lookup)
// ==========================

model ProductCategory {
  id    String @id @default(cuid())
  name  String @unique
  quoteRequests QuoteRequest[]

  @@map("product_categories")
}

// ==========================
// 2b. PROVINCES & WARDS (Lookup địa giới hành chính Việt Nam)
// ==========================

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String?    @unique
  wards     Ward[]
  customers Customer[]
  createdAt DateTime   @default(now())

  @@map("provinces")
}

model Ward {
  id           String   @id @default(cuid())
  name         String
  code         String?
  districtName String?  @map("district_name")
  provinceId   String   @map("province_id")
  province     Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([provinceId])
  @@map("wards")
}

// ==========================
// 5. CUSTOMERS
// ==========================

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  address     String?   @db.Text
  province    String?
  provinceRel Province? @relation(fields: [province], references: [name], onDelete: SetNull)
  ward        String?
  note        String?   @db.Text

  quoteRequests QuoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// ==========================
// 6. QUOTE_REQUESTS (bảng chính)
// ==========================

model QuoteRequest {
  id     String @id @default(cuid())
  code   String @unique // 1. Mã hỏi Giá - vd QG-2026-0001

  status QuoteStatus @default(YC_MOI) // 3. Trạng thái
  requester   User   @relation("Requester", fields: [requesterId], references: [id])
  requesterId String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  desiredDate  DateTime? // 7. Thời gian muốn nhận
  desiredLeadTime String?   @map("desired_lead_time") @db.Text
  materials   QuoteRequestMaterial[]
  material    Material?   @relation("PrimaryMaterial", fields: [materialId], references: [id])
  materialId  String?
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  customerMeasurements String?  @db.Text // 11. Số đo của khách
  closeRatePct         Decimal? @db.Decimal(5, 2) // 12. Khách tỷ lệ chốt
  vat          Decimal? @db.Decimal(5, 2) // 13. VAT
  quotedPrice  Decimal? @db.Decimal(14, 2) // 14. BÁO GIÁ
  quotedDate   DateTime? // 15. Ngày báo giá
  pricer   User?   @relation("Pricer", fields: [pricerId], references: [id]) // 16. Người Báo giá
  pricerId String?
  rejectReason String? @db.Text // bắt buộc khi status = TU_CHOI
  returnReason String? @map("return_reason") @db.Text // bắt buộc khi status = NEED_MORE_INFO
  acceptedAt DateTime? @map("accepted_at") // Mốc lúc PRICING tiếp nhận xử lý (status -> DANG_XLY)
  returnedAt DateTime? @map("returned_at") // Mốc lúc bị trả lại Sale (status -> NEED_MORE_INFO)
  options      QuoteOption[] // Multi-options báo giá song song
  selectedOptionId String?  @map("selected_option_id")
  images        QuoteRequestImage[] // 6. Ảnh sản phẩm (nếu nhiều ảnh)
  version   Int      @default(1) // optimistic locking - chống 2 Pricing tiếp nhận trùng
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([requesterId])
  @@index([requesterId, status])
  @@index([pricerId])
  @@index([pricerId, status])
  @@index([customerId])
  @@index([categoryId])
  @@index([materialId])
  @@index([selectedOptionId])
  @@map("quote_requests")
}

// ==========================
// 6b. QUOTE_REQUEST_MATERIALS (bảng nối tường minh thay cho m2m ẩn)
// ==========================

model QuoteRequestMaterial {
  id             String       @id @default(cuid())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteRequestId String       @map("quote_request_id")
  material       Material     @relation(fields: [materialId], references: [id])
  materialId     String       @map("material_id")

  createdAt DateTime @default(now())

  @@unique([quoteRequestId, materialId])
  @@index([materialId])
  @@map("quote_request_materials")
}

// ==========================
// 7. QUOTE_REQUEST_IMAGES
// Xóa model này và thêm field `imageUrl String?` thẳng vào
// QuoteRequest nếu 1 yêu cầu chỉ có đúng 1 ảnh.
// ==========================

model QuoteRequestImage {
  id             String       @id @default(cuid())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteRequestId String
  imageUrl       String
  uploadedAt     DateTime     @default(now())

  @@index([quoteRequestId])
  @@map("quote_request_images")
}

// ==========================
// 8. METAL PRICES (Lưu giá vàng/bạc/bạch kim vào DB)
// ==========================

model MetalPrice {
  id           String   @id @default("singleton")
  gold24kVnd   Decimal  @map("gold_24k_vnd") @db.Decimal(14, 2)
  silverVnd    Decimal  @map("silver_vnd") @db.Decimal(14, 2)
  platinumVnd  Decimal  @map("platinum_vnd") @db.Decimal(14, 2)
  source       String?
  updatedAt    DateTime @updatedAt

  @@map("metal_prices")
}

// ==========================
// 9. PRICING CONFIG (Cấu hình tham số lõi tính giá 5 bước)
// ==========================

model PricingConfig {
  id               String   @id @default("singleton")
  goldRatios       Json     @map("gold_ratios")
  profitMargins    Json     @map("profit_margins")
  silverMultiplier Decimal  @default(3) @map("silver_multiplier") @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt

  @@map("pricing_config")
}

// ==========================
// 10. QUOTE OPTIONS (Báo giá nhiều phương án song song)
// ==========================

model QuoteOption {
  id             String       @id @default(cuid())
  quoteRequestId String       @map("quote_request_id")
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  optionName     String       @map("option_name")
  materialName   String?      @map("material_name")
  weightChi      Decimal?     @map("weight_chi") @db.Decimal(8, 3)
  laborCost      Decimal?     @map("labor_cost") @db.Decimal(14, 2)
  stoneCost      Decimal?     @map("stone_cost") @db.Decimal(14, 2)
  stoneDescription String?    @map("stone_description") @db.Text
  vat            Decimal?     @db.Decimal(5, 2)
  quotedPrice    Decimal      @map("quoted_price") @db.Decimal(14, 2)
  isSelected     Boolean      @default(false) @map("is_selected")
  note           String?      @db.Text

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([quoteRequestId])
  @@map("quote_options")
}