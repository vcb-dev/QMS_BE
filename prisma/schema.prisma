generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================
// ENUMS
// ==========================

enum Role {
  SALE
  ORDER
  ADMIN
}

enum QuoteStatus {
  PENDING
  PROCESSING
  QUOTED
  REJECTED
  NEED_MORE_INFO
  CLOSED
}

enum StoneType {
  MAIN // Đá chủ
  SIDE // Đá tấm
}

// Trạng thái được chọn của 1 QuoteOption trong danh sách phương án của 1 request —
// SELECTED = phương án đang dùng để báo giá/hiển thị chính, CLOSED = khách đã chốt đúng phương án này,
// NONE = phương án phụ, không có ý nghĩa gì đặc biệt (mặc định).
enum OptionSelectionStatus {
  NONE
  SELECTED
  CLOSED
}

// ==========================
// 1. USERS
// ==========================

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String?     @map("password_hash")
  larkOpenId        String?     @unique @map("lark_open_id")
  avatar            String?
  refreshTokenHash  String?     @map("refresh_token_hash")
  resetTokenHash    String?     @map("reset_token_hash")
  resetTokenExpires DateTime?   @map("reset_token_expires")
  isApproved        Boolean     @default(false) @map("is_approved")
  isActive          Boolean     @default(true) @map("is_active") // false = bị Admin khóa (block), không đăng nhập được
  role              Role
  department        Department? @relation(fields: [departmentId], references: [id])
  departmentId      String?     @map("department_id")

  // Quan hệ ngược - 1 user có thể đóng nhiều vai trong quote_requests
  requestedQuotes       QuoteRequest[]          @relation("Requester")
  assignedQuotes        QuoteRequest[]          @relation("Assignee")
  chatMessages          QuoteChatMessage[]
  chatReads             QuoteChatRead[]
  baseMetalPriceUpdates BaseMetalPriceHistory[]
  pricingFormulaUpdates PricingFormula[]
  auditLogs             AuditLog[]
  larkWebhookUpdates    LarkWebhook[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("users")
}

// ==========================
// 2. DEPARTMENTS (lookup)
// ==========================

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

// ==========================
// 3. BASE METALS (kim loại gốc — giá thị trường hàng ngày, Material FK trỏ vào đây)
// ==========================

model BaseMetal {
  id           String                  @id @default(cuid())
  name         String                  @unique // "Vàng 24K", "Bạc", "Bạch kim", "Titanium"...
  // false = ngừng dùng, ẩn khỏi dropdown chọn — không xóa cứng để không vỡ FK từ Material cũ
  isActive     Boolean                 @default(true) @map("is_active")
  // true = kim loại mặc định khi không xác định được yêu cầu là kim loại nào (VD Sale để trống
  // ô chất liệu lúc dùng máy tính giá nhanh) — CHỈ 1 dòng được true tại 1 thời điểm, thay cho
  // hành vi cũ "không rõ kim loại thì mặc định coi là Vàng"
  isDefault    Boolean                 @default(false) @map("is_default")
  materials    Material[]
  priceHistory BaseMetalPriceHistory[]
  createdAt    DateTime                @default(now()) @map("created_at")

  @@map("base_metals")
}

model BaseMetalPriceHistory {
  id          String    @id @default(cuid())
  baseMetalId String    @map("base_metal_id")
  baseMetal   BaseMetal @relation(fields: [baseMetalId], references: [id], onDelete: Cascade)
  priceVnd    Decimal   @map("price_vnd") @db.Decimal(14, 2)
  // % biến động so với dòng active TRƯỚC ĐÓ của CHÍNH kim loại này — null nếu là lần đầu có giá
  changePct   Decimal?  @map("change_pct") @db.Decimal(6, 2)
  source      String?
  // true = dòng đang dùng để tính giá CỦA KIM LOẠI NÀY — xét theo (baseMetalId, isActive), không
  // toàn cục như MetalPrice cũ (sửa giá Vàng không đụng dòng active của Bạc)
  isActive    Boolean   @default(true) @map("is_active")
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([baseMetalId, isActive])
  @@index([createdAt])
  @@index([updatedById])
  @@map("base_metal_price_history")
}

// ==========================
// 3a. MATERIALS (lookup)
// ==========================

model Material {
  id               String                @id @default(cuid())
  name             String                @unique
  // false = ngừng dùng, ẩn khỏi danh sách chọn — không xóa cứng để không vỡ FK từ QuoteOption cũ
  isActive         Boolean               @default(true) @map("is_active")
  // Kim loại gốc dùng để tra giá thị trường — NULL = phi kim loại (đá/phụ kiện, không tính theo
  // giá kim loại gốc). Thêm kim loại mới = thêm 1 dòng BaseMetal, không sửa code.
  baseMetalId      String?               @map("base_metal_id")
  baseMetal        BaseMetal?            @relation(fields: [baseMetalId], references: [id], onDelete: SetNull)
  // % dùng nhân với giá kim loại gốc lúc tính giá (vàng theo tuổi: vd 18K=75; Bạc/Bạch kim luôn 100
  // vì giá gốc của 2 kim loại này đã là giá bán thẳng, không pha theo tuổi như vàng)
  priceRatioPct    Decimal               @default(100) @map("price_ratio_pct") @db.Decimal(6, 2)
  // Công thức tính lãi mà chất liệu này dùng — nhiều chất liệu có thể trỏ chung 1 công thức
  // (vd 4 loại vàng + bạch kim dùng chung bậc lợi nhuận theo chi phí, bạc dùng hệ số nhân riêng).
  // Thêm chất liệu/kim loại mới chỉ cần trỏ tới công thức có sẵn hoặc tạo công thức mới — không sửa code.
  pricingFormulaId String                @map("pricing_formula_id")
  pricingFormula   PricingFormula        @relation(fields: [pricingFormulaId], references: [id])
  quoteOptions     QuoteOptionMaterial[]

  @@index([pricingFormulaId])
  @@index([baseMetalId])
  @@map("materials")
}

// ==========================
// 3b. PRICING FORMULAS (công thức tính lãi — gắn theo NHÓM, nhiều chất liệu dùng chung 1 công thức)
// ==========================

// MARGIN_TIERS: tra bậc lợi nhuận theo mốc chi phí, chia hệ số divisor (kiểu Vàng/Bạch kim hiện tại)
// MULTIPLIER: nhân thẳng 1 hệ số cố định lên chi phí đã có VAT (kiểu Bạc hiện tại)
enum PricingFormulaType {
  MARGIN_TIERS
  MULTIPLIER
}

model PricingFormula {
  id          String             @id @default(cuid())
  name        String             @unique
  formulaType PricingFormulaType @map("formula_type")
  // MARGIN_TIERS: { tiers: [{ maxCost, divisor, margin }] } — MULTIPLIER: { multipliers: number[] }
  config      Json
  // Công thức mặc định dùng để tính lãi phần ĐÁ khi báo giá (đá tách tính riêng khỏi kim loại,
  // luôn cần 1 bậc lợi nhuận theo chi phí bất kể chất liệu kim loại đi kèm dùng công thức gì)
  isDefault   Boolean            @default(false) @map("is_default")
  // false = ngừng dùng — không xóa cứng để không vỡ FK từ Material còn trỏ tới công thức này
  isActive    Boolean            @default(true) @map("is_active")
  materials   Material[]
  // Người sửa lần gần nhất — FK thật tới User (trước không có), NULL nếu tài khoản đã bị xóa
  updatedBy   User?              @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?            @map("updated_by_id")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([updatedById])
  @@map("pricing_formulas")
}

// ==========================
// 4. PRODUCT CATEGORIES (lookup)
// ==========================

model ProductCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  // false = ngừng dùng, ẩn khỏi danh sách chọn — không xóa cứng để không vỡ FK từ QuoteRequest cũ
  isActive      Boolean        @default(true) @map("is_active")
  laborCost     Decimal?       @map("labor_cost") @db.Decimal(14, 2) // Tiền công chuẩn theo danh mục sản phẩm — Sale dùng giá này, Order vẫn nhập tay
  // VAT chuẩn theo danh mục sản phẩm — thay cho PricingConfig.defaultVatRate (1 giá trị global
  // duy nhất cho cả hệ thống) để mỗi danh mục có thể có mức VAT khác nhau, giống labor_cost.
  // Sale không nhập tay được (chỉ chọn có/không cộng), Order vẫn sửa tự do mỗi lần báo giá.
  vatRate       Decimal?       @map("vat_rate") @db.Decimal(5, 2)
  quoteRequests QuoteRequest[]

  @@map("product_categories")
}

// ==========================
// 2b. PROVINCES & WARDS (Lookup địa giới hành chính Việt Nam)
// ==========================

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String?    @unique
  wards     Ward[]
  customers Customer[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("provinces")
}

model Ward {
  id         String     @id @default(cuid())
  name       String
  code       String?
  provinceId String     @map("province_id")
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  customers  Customer[]
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([provinceId])
  @@map("wards")
}

// ==========================
// 5. CUSTOMERS
// ==========================

model Customer {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  address    String?   @db.Text
  // Khóa ngoại thật thay cho tên tỉnh/phường dạng string tự do — tránh vỡ khi sáp nhập/đổi tên
  // hành chính. NULL = customer không chọn qua danh mục (tạo trước khi có FK, hoặc bỏ trống).
  provinceId String?   @map("province_id")
  province   Province? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  wardId     String?   @map("ward_id")
  ward       Ward?     @relation(fields: [wardId], references: [id], onDelete: SetNull)
  note       String?   @db.Text

  quoteRequests QuoteRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([provinceId])
  @@index([wardId])
  @@map("customers")
}

// ==========================
// 6. QUOTE_REQUESTS (bảng chính)
// ==========================

model QuoteRequest {
  id   String @id @default(cuid())
  code String @unique // 1. Mã hỏi Giá - vd QG-2026-0001

  status               QuoteStatus         @default(PENDING) // 3. Trạng thái
  requester            User                @relation("Requester", fields: [requesterId], references: [id])
  requesterId          String              @map("requester_id")
  customer             Customer            @relation(fields: [customerId], references: [id])
  customerId           String              @map("customer_id")
  desiredDate          DateTime?           @map("desired_date") // 7. Thời gian muốn nhận
  desiredLeadTime      String?             @map("desired_lead_time") @db.Text
  category             ProductCategory     @relation(fields: [categoryId], references: [id])
  categoryId           String              @map("category_id")
  customerMeasurements String?             @map("customer_measurements") @db.Text // 11. Số đo của khách
  closeRatePct         Decimal?            @map("close_rate_pct") @db.Decimal(5, 2) // 12. Khách tỷ lệ chốt
  // Cụm dữ liệu báo giá (vat/quotedPrice/quotedDate/pricer/materials/stones) nằm hết ở QuoteOption —
  // 1 request có thể có nhiều option do nhiều pricer tạo để so sánh, không thể gắn 1 giá trị chung ở đây.
  assignee             User?               @relation("Assignee", fields: [assigneeId], references: [id]) // Người đang tiếp nhận/xử lý case (khác pricer của từng option)
  assigneeId           String?             @map("assignee_id")
  rejectReason         String?             @map("reject_reason") @db.Text // bắt buộc khi status = TU_CHOI
  returnReason         String?             @map("return_reason") @db.Text // bắt buộc khi status = NEED_MORE_INFO
  acceptedAt           DateTime?           @map("accepted_at") // Mốc lúc PRICING tiếp nhận xử lý (status -> DANG_XLY)
  returnedAt           DateTime?           @map("returned_at") // Mốc lúc bị trả lại Sale (status -> NEED_MORE_INFO)
  options              QuoteOption[]       @relation("RequestOptions") // Multi-options báo giá song song
  images               QuoteRequestImage[] // 6. Ảnh sản phẩm (nếu nhiều ảnh)
  videoUrl             String?             @map("video_url") @db.Text // Video sản phẩm/mẫu thực tế (1 video, Cloudinary resource_type=video)
  chatMessages         QuoteChatMessage[]
  chatReads            QuoteChatRead[]
  version              Int                 @default(1) // optimistic locking - chống 2 Pricing tiếp nhận trùng
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  // Denormalize "phương án báo giá đại diện" (pickPrimaryOption) — từ migration
  // 20260826_final_option_db_trigger trở đi được giữ đúng bằng DB trigger (sync_final_option() +
  // trg_quote_options_sync_final trên bảng quote_options), không còn phụ thuộc app-layer gọi đúng
  // hàm sync. Cột scalar thuần, không khai báo quan hệ Prisma — đây là cache, không phải quan hệ
  // nghiệp vụ (không tạo FK vòng tròn).
  finalOptionId String?  @map("final_option_id")
  finalPrice    Decimal? @map("final_price") @db.Decimal(14, 2)

  @@index([status, finalPrice])
  @@index([status, createdAt(sort: Desc)])
  @@index([requesterId])
  @@index([requesterId, status])
  @@index([assigneeId])
  @@index([assigneeId, status])
  @@index([customerId])
  @@index([categoryId])
  @@map("quote_requests")
}

// ==========================
// 6c. STONES (lookup — danh mục đá chủ / đá tấm)
// ==========================

model Stone {
  id           String             @id @default(cuid())
  stoneType    StoneType          @map("stone_type") // MAIN = đá chủ, SIDE = đá tấm
  name         String // Tên đá
  cut          String? // Giác cắt
  size         String? // Size đá
  price        Decimal            @db.Decimal(14, 2) // Giá / viên
  // false = ngừng dùng, ẩn khỏi danh sách chọn — không xóa cứng để không vỡ FK từ QuoteOption cũ
  isActive     Boolean            @default(true) @map("is_active")
  quoteOptions QuoteOptionStone[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Thư viện sản phẩm lọc + gộp nhóm nặng theo (stoneType, name) — đá chủ MAIN định danh sản phẩm.
  @@index([stoneType, name])
  @@map("stones")
}

// ==========================
// 7. QUOTE_REQUEST_IMAGES
// Xóa model này và thêm field `imageUrl String?` thẳng vào
// QuoteRequest nếu 1 yêu cầu chỉ có đúng 1 ảnh.
// ==========================

model QuoteRequestImage {
  id             String       @id @default(cuid())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteRequestId String       @map("quote_request_id")
  imageUrl       String       @map("image_url")
  uploadedAt     DateTime     @default(now()) @map("uploaded_at")

  @@index([quoteRequestId])
  @@map("quote_request_images")
}

// ==========================
// PricingConfig (bảng cấu hình global cũ) đã bị xóa hoàn toàn — goldRatios chuyển sang
// Material.priceRatioPct, profitMargins/silverMultipliers chuyển sang PricingFormula,
// defaultVatRate chuyển sang ProductCategory.vatRate. Không còn gì đáng giữ lại ở bảng này.
// ==========================

// ==========================
// 10. QUOTE OPTIONS (Báo giá nhiều phương án song song)
// ==========================

model QuoteOption {
  id             String       @id @default(cuid())
  quoteRequestId String       @map("quote_request_id")
  quoteRequest   QuoteRequest @relation("RequestOptions", fields: [quoteRequestId], references: [id], onDelete: Cascade)

  optionName       String                @map("option_name")
  weightChi        Decimal?              @map("weight_chi") @db.Decimal(8, 3) // tổng số chi (giữ để đọc nhanh, không join)
  laborCost        Decimal?              @map("labor_cost") @db.Decimal(14, 2)
  stoneCost        Decimal?              @map("stone_cost") @db.Decimal(14, 2)
  // Giá kim loại + giá đá đã bán (sau margin) — lưu riêng để cộng ra đúng TỔNG BÁO GIÁ CHỐT khi xem lại
  totalMetalCost   Decimal?              @map("total_metal_cost") @db.Decimal(14, 2)
  // Giá vốn kim loại THÔ (trọng lượng × đơn giá, trước công/VAT/margin) — tách riêng để xem lại
  // được chi tiết giá gốc/VAT/lãi kim loại giống lúc tính, thay vì chỉ có totalMetalCost đã gộp sẵn
  metalRawCost     Decimal?              @map("metal_raw_cost") @db.Decimal(14, 2)
  stonePrice       Decimal?              @map("stone_price") @db.Decimal(14, 2)
  vat              Decimal?              @db.Decimal(5, 2)
  quotedPrice      Decimal?              @map("quoted_price") @db.Decimal(14, 2) // NULL = option nháp (vd Sale khai chất liệu mong muốn), chưa có giá
  quotedDate       DateTime?             @map("quoted_date") // Mốc thật sự gửi báo giá cho khách — khác createdAt (mốc tạo record nháp)
  note             String?               @db.Text
  // Tên/mô tả đá khi Order nhập tay tổng tiền đá (không chọn từ danh mục Stone) — không có
  // QuoteOptionStone nào để tra tên, nên phải lưu snapshot text này, khác case đá chọn từ danh mục.
  stoneDescription String?               @map("stone_description") @db.Text
  // SELECTED = phương án chính đang dùng để báo giá, CLOSED = khách đã chốt đúng phương án này —
  // nguồn sự thật duy nhất cho "phương án nào đang được chọn", thay cho QuoteRequest.selectedOptionId cũ.
  selectionStatus  OptionSelectionStatus @default(NONE) @map("selection_status")

  materials QuoteOptionMaterial[]
  stones    QuoteOptionStone[]

  // Khóa gộp trùng sản phẩm cho trang Quản Lý Sản Phẩm — categoryId (của đơn cha) + chất liệu
  // (materialId:weightChi, sort) + đá (stoneId:quantity, sort, hoặc mô tả/giá tay). Tính SẴN lúc
  // ghi option (buildOptionCreateInput) — KHÔNG tính lại lúc đọc, tránh phải join nhiều bảng mỗi
  // lần query danh sách sản phẩm.
  dedupKey String? @map("dedup_key")

  // Khóa gộp nhóm THÔ cho trang Thư Viện Sản Phẩm — mịn hơn dedupKey nên tách riêng:
  // "<categoryId> | <baseMetalId của chất liệu nặng nhất> | <tập tên đá MAIN, lowercase+sort>".
  // Bỏ tuổi vàng / khối lượng / size-giác-cắt-số lượng đá / đá SIDE. Tính SẴN lúc ghi option
  // (computeLibraryGroupKey), để getLibraryProducts GROUP BY + phân trang phía SQL thay vì kéo
  // toàn bộ option về JS rồi mới gộp.
  libraryGroupKey String? @map("library_group_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([quoteRequestId])
  @@index([dedupKey])
  @@index([libraryGroupKey])
  @@map("quote_options")
}

// ==========================
// 10b. QUOTE_OPTION_MATERIALS (chi tiết chất liệu trong 1 phương án — truy vết, không chỉ text tóm tắt)
// ==========================

model QuoteOptionMaterial {
  id         String      @id @default(cuid())
  option     QuoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId   String      @map("option_id")
  material   Material    @relation(fields: [materialId], references: [id])
  materialId String      @map("material_id")
  weightChi  Decimal?    @map("weight_chi") @db.Decimal(8, 3)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([optionId, materialId])
  @@index([materialId])
  @@map("quote_option_materials")
}

// ==========================
// 10c. QUOTE_OPTION_STONES (chi tiết đá trong 1 phương án — truy vết, không chỉ text tóm tắt)
// ==========================

model QuoteOptionStone {
  id               String      @id @default(cuid())
  option           QuoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId         String      @map("option_id")
  stone            Stone       @relation(fields: [stoneId], references: [id])
  stoneId          String      @map("stone_id")
  quantity         Int         @default(1)
  // Giá/viên TẠI THỜI ĐIỂM báo giá — Stone.price có thể đổi sau này, không snapshot thì xem lại
  // đơn cũ sẽ ra giá đá SAI (giá hôm nay) dù QuoteOption.stonePrice đã đóng băng đúng tổng tiền.
  // NULL = record tạo trước khi có field này, FE/BE fallback đọc Stone.price hiện tại.
  unitPriceAtQuote Decimal?    @map("unit_price_at_quote") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([optionId, stoneId])
  @@index([stoneId])
  @@map("quote_option_stones")
}

// ==========================
// 9. AUDIT LOG — đếm hành động theo role (2.3 + 2.4 gộp)
// Không FK tới User: lưu snapshot actorName/actorRole để log không mất khi tài khoản bị xóa
// ==========================
model AuditLog {
  id         String   @id @default(cuid())
  // FK thật tới User — lấy tên qua quan hệ thay vì lưu trùng; NULL nếu tài khoản đã bị xóa (giữ lịch sử log)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?  @map("actor_id")
  actorRole  Role     @map("actor_role") // snapshot role LÚC hành động — user đổi role sau đó không ảnh hưởng log cũ
  action     String // vd: ACCEPT_QUOTE, CREATE_QUOTE, LOGIN, APPROVE_USER...
  entityType String?  @map("entity_type") // vd: QuoteRequest, User, Customer
  entityId   String?  @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorRole, action])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ==========================
// QUOTE CHAT — trao đổi Sale <-> Order theo từng yêu cầu báo giá
// Không có bảng Conversation riêng: participants lấy thẳng từ
// QuoteRequest.requesterId/assigneeId, quoteRequestId trên message tự nó
// là khóa xác định luồng chat (1 request = đúng 1 luồng chat cố định).
// ==========================

model QuoteChatMessage {
  id             String       @id @default(cuid())
  quoteRequestId String       @map("quote_request_id")
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  content        String?      @db.Text // null nếu tin chỉ có ảnh
  imageUrl       String?      @map("image_url")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([quoteRequestId, createdAt])
  @@map("quote_chat_messages")
}

model QuoteChatRead {
  quoteRequestId String       @map("quote_request_id")
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime     @map("last_read_at")

  @@id([quoteRequestId, userId])
  @@map("quote_chat_reads")
}

// ==========================
// LARK WEBHOOK — cấu hình thông báo ra nhóm Lark, ADMIN quản lý qua UI.
// lark_webhook: danh mục Custom Bot thật — 1 dòng = 1 bot, URL & signing secret là DUY NHẤT.
// lark_webhook_subscription: bảng nối nhiều–nhiều, bot nào nhận thông báo cho audit action nào.
// Không có bảng đứng 1 mình: lark_webhook FK -> users (updated_by), subscription FK -> lark_webhook.
// `action` khớp giá trị audit_logs.action (cùng là text, không FK — audit_logs.action cũng không FK).
// ==========================

model LarkWebhook {
  id            String                   @id @default(cuid())
  chatName      String                   @map("chat_name") // tên nhóm Lark đích (chỉ để hiển thị)
  botName       String?                  @map("bot_name") // tên Custom Bot — tùy chọn
  webhookUrl    String                   @unique @map("webhook_url")
  webhookSecret String?                  @unique @map("webhook_secret") // signing secret, không trả về client
  isEnabled     Boolean                  @default(true) @map("is_enabled") // tắt = tạm ngưng, không xóa
  updatedBy     User?                    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById   String?                  @map("updated_by_id")
  subscriptions LarkWebhookSubscription[]
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([updatedById])
  @@map("lark_webhook")
}

model LarkWebhookSubscription {
  id        String      @id @default(cuid())
  webhook   LarkWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId String      @map("webhook_id")
  action    String // giá trị AuditAction, vd QUOTE_PRICE, REJECT_QUOTE
  isEnabled Boolean     @default(true) @map("is_enabled")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([webhookId, action])
  @@index([action])
  @@map("lark_webhook_subscription")
}
